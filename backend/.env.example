# DATABASE_URL is required for backend operation and must be a valid PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/almasa_jewelry"

# SECRET_KEY must be a long, randomly generated string for signing JWT tokens
# Example generation: openssl rand -hex 32
SECRET_KEY="your_super_secret_key_change_me_in_production"

# ENVIRONMENT should be set to "production" in production environments
ENVIRONMENT="production"

# PORT determines the backend listener port (defaults to 8000)
PORT=8000

# GOLD_API_KEY is used to sync external gold prices from GoldAPI.io
GOLD_API_KEY=""
